# ============================================================================
# Seeed reTerminal E1001 Google Tasks Dashboard - Environment Configuration
# ============================================================================

# HTTP Server Port
PORT=8004

# Google Tasks API Configuration
# Option A: OAuth 2.0 Client credentials with Refresh Token (Recommended for continuous operation)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""

# Option B: Direct Bearer Access Token (Useful for quick temporary testing)
GOOGLE_ACCESS_TOKEN=""

# Optional: Specific Google Tasks List ID (Leave empty to fetch primary default list)
GOOGLE_TASK_LIST_ID=""

# Cache TTL in milliseconds (Default: 60000 = 1 minute to preserve quota)
CACHE_TTL_MS=60000

# Fallback mode: true to force realistic mock data without Google Cloud setup
USE_MOCK_DATA=false
