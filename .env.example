# Environment Configuration for Seeed E1001 Analog Clock Screen
PORT=3000
DEVICE_RESOLUTION=800x480
REFRESH_INTERVAL_SECONDS=60
USE_MOCK_DATA=false
DEFAULT_PALETTE_INDEX=0
GLOBAL_SEED=42

# Wi-Fi & NTP Configuration
WIFI_SSID="YOUR_SSID"
WIFI_PASSWORD="YOUR_PASSWORD"
NTP_SERVER="pool.ntp.org"
TIMEZONE_OFFSET_HOURS=0
