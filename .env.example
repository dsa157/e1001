# ============================================================================
# Seeed reTerminal E1001 Master Dashboard Hub - Environment Configuration
# Version: 2026.09.29.14.42.00
# ============================================================================

# --- MASTER HUB CONFIGURATION ---
HUB_PORT=8000                          # Master web dashboard & preview port
CYCLE_ENABLED=true                     # Auto-cycle between enabled modules (true/false)
DEFAULT_DWELL_SECONDS=30               # Global dwell time per module in seconds
ACTIVE_PALETTE_INDEX=0                 # 0: Paper Light, 1: Classic Dark, 2: 1-Bit High Contrast, 3: Carbon Slate, 4: Stipple
GLOBAL_SEED=1001                       # Deterministic random seed

# --- HARDWARE DISPLAY RESOLUTION ---
DISPLAY_WIDTH=800
DISPLAY_HEIGHT=480

# --- MODULE API KEYS & SETTINGS ---
# Weather (Open-Meteo is free & keyless, optional default city)
WEATHER_DEFAULT_CITY="Hanoi"
WEATHER_TIME_FORMAT=12                 # 12 or 24
WEATHER_UNITS="C"                      # C or F

# Crypto Dashboard (CoinMarketCap)
COINMARKETCAP_API_KEY=""               # Get from https://coinmarketcap.com/api/
CRYPTO_SYMBOLS="BTC,ETH,SOL,ADA"
CRYPTO_TIME_FORMAT=12                   # 12 or 24

# Google Tasks Dashboard
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8004/oauth2callback"
GOOGLE_REFRESH_TOKEN=""
USE_MOCK_DATA=true                     # Set to false once real OAuth tokens are in place

# QLOCKTWO Word Clock
QLOCKTWO_LANGUAGE="en"                 # de, en, nl, it, es, fr, da, ru, sv

# --- DEVICE WI-FI & ESPHOME ---
WIFI_SSID=""
WIFI_PASSWORD=""
DEVICE_IP=""
